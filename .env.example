# AetherClaw (灵爪) Environment Configuration Template
# 用法：复制本文件为 `.env`（与 package.json 同目录），按需修改即可，启动时会自动读取。
# 也可以完全不用本文件，直接在 Web 控制台右上角「API 设置」里零代码配置。
# 优先级：Web 界面保存的配置 > 系统环境变量 / .env > 内置默认值
# ⚠️ .env 已被 .gitignore 忽略，不会被提交到 GitHub；请勿把真实密钥写进 .env.example。

# ---- LLM Provider (OpenAI / DeepSeek / Qwen / Kimi / Ollama 兼容接口) ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
# 单次大模型请求超时（毫秒）
LLM_TIMEOUT_MS=60000

# ---- Web Console ----
PORT=3721
# 默认仅本机可访问。若改为 0.0.0.0（局域网/服务器），必须配合 Token：
HOST=127.0.0.1
# 访问令牌：HOST 非回环地址时强制启用；留空则启动时自动生成并打印
# AETHERCLAW_TOKEN=change-me-to-a-long-random-string

# ---- Data directory (data/ 与 skills/ 的存放位置，默认为当前目录) ----
# AETHERCLAW_HOME=/var/lib/aetherclaw

# ---- Execution & Safety ----
ALLOW_SHELL_EXEC=true
ALLOW_FILE_WRITE=true
SHELL_TIMEOUT_MS=15000
AUTO_EVOLVE_SKILLS=true
