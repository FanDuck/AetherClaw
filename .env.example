# AetherClaw (灵爪) Environment Configuration Template
# Copy this file to .env or configure directly in the Web UI Console!

# LLM Provider Settings (OpenAI / DeepSeek / Qwen / Ollama compatible)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat

# Web Console Server Settings
PORT=3721
HOST=127.0.0.1

# Security & Execution Settings
ALLOW_SHELL_EXEC=true
SHELL_TIMEOUT_MS=15000
AUTO_EVOLVE_SKILLS=true
