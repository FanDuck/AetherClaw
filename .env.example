# AetherClaw (灵爪) Environment Configuration Template
# 用法：复制本文件为 `.env`（与 package.json 同目录），按需修改即可，启动时会自动读取。
# 也可以完全不用本文件，直接在 Web 控制台右上角「API 设置」里零代码配置。
# 优先级：Web 界面保存的配置 > 系统环境变量 / .env > 内置默认值
# ⚠️ .env 已被 .gitignore 忽略，不会被提交到 GitHub；请勿把真实密钥写进 .env.example。

# ---- LLM Provider (OpenAI / DeepSeek / Qwen / Kimi / Ollama 兼容接口) ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
# 单次大模型请求超时（毫秒）
LLM_TIMEOUT_MS=60000

# ---- Web Console & TLS Security ----
PORT=3721
# 默认仅本机回环访问，关闭纯明文公网暴露。生产环境请前置 Nginx (deploy/nginx.conf) 或 Caddy (deploy/Caddyfile) 配置 TLS：
HOST=127.0.0.1
# 若前置了 Nginx / Caddy HTTPS 反向代理，设为 true 将强制校验 X-Forwarded-Proto: https 并下发 HSTS 响应头
BEHIND_TLS_PROXY=false
# Header Bearer Token 访问令牌 (Authorization: Bearer <token>)；禁止通过 URL ?token= 明文传参
# AETHERCLAW_TOKEN=change-me-to-a-long-random-string

# ---- Data directory (data/ 与 skills/ 的存放位置，默认为当前目录) ----
# AETHERCLAW_HOME=/var/lib/aetherclaw

# ---- Execution & Container Sandbox (host | docker | gvisor) ----
ALLOW_SHELL_EXEC=true
ALLOW_FILE_WRITE=true
SHELL_TIMEOUT_MS=15000
AUTO_EVOLVE_SKILLS=true
# 工具命令沙箱环境：host (宿主机护栏模式) | docker (受限容器沙箱 --cap-drop=ALL --read-only) | gvisor (runsc 内核沙箱)
SANDBOX_MODE=host
SANDBOX_IMAGE=alpine:3.20
SANDBOX_MEMORY_MB=256
SANDBOX_NETWORK=none
